APP_NAME=LucidUI Backend
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=true
CORS_ALLOW_ORIGINS=*
MAX_UPLOAD_SIZE_BYTES=20971520

# LLM interpretation layer (app.llm). "mock" (default) needs no API key and
# never calls a network. Set to "gemini" plus GEMINI_API_KEY to use a real
# model. See docs/architecture/decisions/ADR-003-json-only-llm-input.md —
# only deterministic metric JSON and analysis context are ever sent, never
# the uploaded image.
LLM_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
LLM_MAX_OUTPUT_TOKENS=2048

# UIClip evaluation layer (app.uiclip). "mock" (default) needs no model
# download and never calls a network. "huggingface" loads the real BIG Lab
# UIClip checkpoint via transformers.CLIPModel/CLIPProcessor — see
# docs/research/uiclip-integration.md. Any other value gracefully degrades
# to uiclip.status = "unavailable" rather than raising. UICLIP_MODEL_ID and
# UICLIP_DEVICE only matter when UICLIP_PROVIDER=huggingface.
UICLIP_PROVIDER=mock
UICLIP_MODEL_ID=biglab/uiclip_jitteredwebsites-2-224-paraphrased
UICLIP_DEVICE=auto
